{
  "name": "trade-bot",
  "version": "1.0.0",
  "description": "Simple echo Telegram bot",
  "main": "dist/bot.js",
  "type": "module",
  "imports": {
    "#commands": {
      "development": "./commands/index.ts",
      "default": "./dist/commands/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development bot.ts",
    "build": "tsc",
    "start": "node dist/bot.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "node-telegram-bot-api": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
